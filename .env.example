# MiniMax CLI uses OPENAI_API_KEY in this environment
OPENAI_API_KEY=sk-your-key-here

# Default model (cheap + good for creative work)
REEL_STUDIO_MODEL=MiniMax-M3

# Where generated reels land
REEL_STUDIO_OUTPUT_DIR=./output
REEL_STUDIO_DB_PATH=./data/reel_studio.db

# MiniMax CLI command (override only if your install is in a weird place)
REEL_STUDIO_MINIMAX_CMD=minimax

# 'subprocess' (default) uses ~/.minimax/bin/minimax.cmd CLI
# 'agent' uses the in-process MiniMax-M3 via the hermes runtime (no CLI needed)
REEL_STUDIO_BACKEND=subprocess
